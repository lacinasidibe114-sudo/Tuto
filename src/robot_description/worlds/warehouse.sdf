<?xml version="1.0"?>
<sdf version="1.6">
  <world name="warehouse">
    <physics name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.08 0.08 0.08 1</background>
      <shadows>true</shadows>
    </scene>
    
    <gravity>0 0 -9.81</gravity>

    <!-- ========================================== -->
    <!-- AJOUT DU SOL POUR EMPÊCHER LE ROBOT DE TOMBER -->
    <!-- ========================================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <!-- Collision (Physique) -->
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <!-- Visuel (Ce que l'on voit) -->
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <!-- ========================================== -->

    <!-- Éclairage -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>-10 -10 25 0.35 0.2 0.4</pose>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.3 0.3 -1</direction>
    </light>
    <light name="warehouse_lights" type="point">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <attenuation><range>35</range><constant>0.6</constant><linear>0.01</linear></attenuation>
    </light>

    <!-- Quatre murs : 30 m x 20 m, hauteur utile 8 m. -->
    <model name="warehouse_structure">
      <static>true</static>
      <link name="structure">
        <collision name="north_wall"><geometry><box><size>30 0.2 8</size></box></geometry><pose>0 10 4 0 0 0</pose></collision>
        <collision name="south_wall"><geometry><box><size>30 0.2 8</size></box></geometry><pose>0 -10 4 0 0 0</pose></collision>
        <collision name="east_wall"><geometry><box><size>0.2 20 8</size></box></geometry><pose>15 0 4 0 0 0</pose></collision>
        <collision name="west_wall"><geometry><box><size>0.2 20 8</size></box></geometry><pose>-15 0 4 0 0 0</pose></collision>
        <visual name="north_visual"><geometry><box><size>30 0.2 8</size></box></geometry><pose>0 10 4 0 0 0</pose><material><ambient>0.18 0.2 0.22 1</ambient><diffuse>0.18 0.2 0.22 1</diffuse></material></visual>
        <visual name="south_visual"><geometry><box><size>30 0.2 8</size></box></geometry><pose>0 -10 4 0 0 0</pose><material><ambient>0.18 0.2 0.22 1</ambient><diffuse>0.18 0.2 0.22 1</diffuse></material></visual>
        <visual name="east_visual"><geometry><box><size>0.2 20 8</size></box></geometry><pose>15 0 4 0 0 0</pose><material><ambient>0.18 0.2 0.22 1</ambient><diffuse>0.18 0.2 0.22 1</diffuse></material></visual>
        <visual name="west_visual"><geometry><box><size>0.2 20 8</size></box></geometry><pose>-15 0 4 0 0 0</pose><material><ambient>0.18 0.2 0.22 1</ambient><diffuse>0.18 0.2 0.22 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>